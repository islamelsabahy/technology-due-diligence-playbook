{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechnologyDiligenceFinding",
  "type": "object",
  "required": [
    "finding_id",
    "domain",
    "finding",
    "severity",
    "status"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "finding": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "business_impact": {
      "type": [
        "string",
        "null"
      ]
    },
    "transaction_impact": {
      "type": [
        "string",
        "null"
      ]
    },
    "estimated_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    }
  }
}
